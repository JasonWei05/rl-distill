--- /dev/null
+++ b/experiments/text_maze/verl/workers/rollout/graph_decode.py
@@ -0,0 +1,51 @@
+"""CUDA-graph sampling decode for small models (rollout.graph_generate, maze study).
+
+A drop-in for model.generate(do_sample=True, top_k=0, top_p=1, return_dict_in_generate=True, output_logits=True) on
+unpadded prompts: prefill once, then one-token decode steps on a StaticCache with the step captured as a CUDA graph
+(torch.compile mode="reduce-overhead"). Returns .sequences (prompt + generated, pad after EOS like HF) and .logits
+(raw per-step logits, as HF's output_logits). The per-token cost of HF generate for a 4-layer model is almost all
+kernel-launch / Python overhead, which the graph removes.
+"""
+
+from types import SimpleNamespace
+
+import torch
+from transformers import StaticCache
+
+
+class GraphDecoder:
+    def __init__(self, model, max_new_tokens):
+        self.model = model
+        self.max_new = max_new_tokens
+        self.caches = {}  # (batch, prompt length) -> StaticCache
+        self.step = torch.compile(self._step, mode="reduce-overhead", fullgraph=False)
+
+    def _step(self, ids, pos, cache):
+        return self.model(input_ids=ids, cache_position=pos, past_key_values=cache, use_cache=True).logits[:, -1]
+
+    @torch.no_grad()
+    def generate(self, input_ids, temperature, eos_ids, pad_id, num_return_sequences=1, want_logits=True):
+        x = input_ids.repeat_interleave(num_return_sequences, 0) if num_return_sequences > 1 else input_ids
+        B, L = x.shape
+        key = (B, L)
+        if key not in self.caches:
+            self.caches[key] = StaticCache(config=self.model.config, max_batch_size=B, max_cache_len=L + self.max_new,
+                                           device=x.device, dtype=next(self.model.parameters()).dtype)
+        cache = self.caches[key]
+        cache.reset()
+        eos = torch.tensor(eos_ids, device=x.device)
+        logits = self._step(x, torch.arange(L, device=x.device), cache).float()
+        done = torch.zeros(B, dtype=torch.bool, device=x.device)
+        toks, all_logits = [], []
+        for t in range(self.max_new):
+            if want_logits:
+                all_logits.append(logits)
+            nxt = torch.multinomial(torch.softmax(logits / max(float(temperature), 1e-6), -1), 1).squeeze(1)
+            nxt = torch.where(done, torch.full_like(nxt, pad_id), nxt)
+            toks.append(nxt)
+            done |= (nxt[:, None] == eos).any(1)  # not torch.isin: its sort path (many eos ids) syncs, which breaks capture
+            if t % 8 == 7 and bool(done.all()):  # one host sync per 8 tokens
+                break
+            if t + 1 < self.max_new:
+                logits = self.step(nxt[:, None].clone(), torch.tensor([L + t], device=x.device), cache).float().clone()
+        return SimpleNamespace(sequences=torch.cat([x, torch.stack(toks, 1)], 1), logits=tuple(all_logits) if want_logits else None)
