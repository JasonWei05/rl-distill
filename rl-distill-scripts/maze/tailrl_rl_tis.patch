+class MazeTokenCache(Dataset):
+    """Pre-tokenized training set written by rl-distill maze/tokenize_maze_sft.py (a directory: tokens.npy uint8 ids
+    concatenated, offsets.npy, path_start.npy, meta.json); the tokens are memory-mapped. Items equal MazeSFTDataset's:
+    labels are -100 up to and including PATH_START. Training items only (no prompt / sequence strings). Refuses a cache
+    built from a different source file (byte size), sequence cap or tokenizer (vocabulary + a re-encoded probe item)."""
+
+    def __init__(self, path: str, source: str, tokenizer, max_length: int):
+        start_time = time.time()
+        with open(os.path.join(path, "meta.json")) as f:
+            meta = json.load(f)
+        assert meta["max_length"] == max_length, (meta["max_length"], max_length)
+        assert meta["source_bytes"] == os.path.getsize(source), \
+            f"{path} was built from a {meta['source_bytes']}-byte file, {source} has {os.path.getsize(source)} bytes"
+        assert meta["vocab"] == tokenizer.get_vocab(), "tokenizer vocabulary differs from the one the cache was built with"
+        probe = meta["probe"]
+        assert tokenizer.encode(probe["text"], add_special_tokens=False)[:max_length] == probe["ids"], \
+            "tokenizer encodes differently from the one the cache was built with"
+        self.tokens = np.load(os.path.join(path, "tokens.npy"), mmap_mode="r")
+        self.offsets = np.load(os.path.join(path, "offsets.npy"))
+        self.path_start = np.load(os.path.join(path, "path_start.npy"))
+        logger.info(f"Loaded {len(self)} pre-tokenized examples from {path} in {time.time() - start_time:.2f}s "
+                    f"(built {meta['built']} from {os.path.basename(meta['source'])})")
+
+    def __len__(self):
+        return len(self.offsets) - 1
+
+    def __getitem__(self, idx):
+        ids = torch.from_numpy(np.array(self.tokens[self.offsets[idx]:self.offsets[idx + 1]], dtype=np.int64))
+        labels = ids.clone()
+        labels[: int(self.path_start[idx]) + 1] = -100
+        return {"input_ids": ids, "labels": labels, "attention_mask": torch.ones_like(ids)}
+
+
