+@register_policy_loss("tis")
+def compute_policy_loss_tis(old_log_prob, log_prob, advantages, response_mask, loss_agg_mode="token-mean", config=None):
+    """Token-level truncated importance sampling for one update per rollout batch (no old-log-prob recompute).
+
+    old_log_prob is the rollout engine's log-prob of each sampled token (behaviour policy); log_prob is the trainer's at the
+    current weights, which are the weights that generated the batch (single update), so their ratio is the train-inference
+    mismatch alone. Each token's policy-gradient term -A * log pi is weighted by w = min(pi_train / pi_rollout, C) (detached),
+    C = actor.policy_loss.tis_cap (default 2.0). Returns (pg_loss, frac of tokens with ratio > C, mean log(pi_rollout /
+    pi_train) [the k1 mismatch estimate], frac of tokens with ratio < 1 / C).
+    """
+    cap = float(config.policy_loss.get("tis_cap", 2.0)) if config is not None else 2.0
+    log_ratio = torch.clamp(log_prob.detach() - old_log_prob, min=-20.0, max=20.0)
+    ratio = torch.exp(log_ratio)
+    weight = torch.clamp(ratio, max=cap)
+    pg_losses = -advantages * weight * log_prob
+    pg_loss = agg_loss(loss_mat=pg_losses, loss_mask=response_mask, loss_agg_mode=loss_agg_mode)
+    frac_capped = verl_F.masked_mean(torch.gt(ratio, cap).float(), response_mask)
+    mismatch_kl = verl_F.masked_mean(-log_ratio, response_mask)
+    frac_low = verl_F.masked_mean(torch.lt(ratio, 1.0 / cap).float(), response_mask)
+    return pg_loss, frac_capped, mismatch_kl, frac_low
+
+
+@register_policy_loss("icepop")
+def compute_policy_loss_icepop(old_log_prob, log_prob, advantages, response_mask, loss_agg_mode="token-mean", config=None):
+    """IcePop: token-level train-inference masking for one update per rollout batch (no old-log-prob recompute).
+
+    As "tis", but the detached weight w = pi_train / pi_rollout is kept as is inside [L, U] and zeroed outside it (the token
+    drops out of the policy gradient) instead of being capped: L = actor.policy_loss.icepop_low (default 0.5),
+    U = actor.policy_loss.icepop_high (default 5.0). Returns (pg_loss, frac of tokens masked above U, mean log(pi_rollout /
+    pi_train) [the k1 mismatch estimate], frac of tokens masked below L).
+    """
+    low = float(config.policy_loss.get("icepop_low", 0.5)) if config is not None else 0.5
+    high = float(config.policy_loss.get("icepop_high", 5.0)) if config is not None else 5.0
+    log_ratio = torch.clamp(log_prob.detach() - old_log_prob, min=-20.0, max=20.0)
+    ratio = torch.exp(log_ratio)
+    keep = (ratio >= low) & (ratio <= high)
+    weight = torch.where(keep, ratio, torch.zeros_like(ratio))
+    pg_losses = -advantages * weight * log_prob
+    pg_loss = agg_loss(loss_mat=pg_losses, loss_mask=response_mask, loss_agg_mode=loss_agg_mode)
+    frac_high = verl_F.masked_mean(torch.gt(ratio, high).float(), response_mask)
+    mismatch_kl = verl_F.masked_mean(-log_ratio, response_mask)
+    frac_low = verl_F.masked_mean(torch.lt(ratio, low).float(), response_mask)
+    return pg_loss, frac_high, mismatch_kl, frac_low
+
