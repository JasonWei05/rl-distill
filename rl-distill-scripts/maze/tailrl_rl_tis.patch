diff --git a/experiments/text_maze/verl/workers/actor/prefix_forward.py b/experiments/text_maze/verl/workers/actor/prefix_forward.py
new file mode 100644
index 0000000..6eba483
--- /dev/null
+++ b/experiments/text_maze/verl/workers/actor/prefix_forward.py
@@ -0,0 +1,35 @@
+"""Shared-prompt training forward (actor.prefix_shared_forward, maze study).
+
+Same logits as one forward over prompt + response per row, computed with less work when rows share prompts (the 16
+samples of a GRPO group): each distinct prompt in the micro-batch (tokens, mask and positions) is run once with its KV
+cache kept for autograd, every row then runs only its response tokens against its group's prompt cache, and the response
+is trimmed to the longest real response in the micro-batch. Gradients reach the shared prompt computation summed over the
+group's rows, which equals the per-row computation. Any row order works.
+"""
+
+import torch
+
+
+def prefix_shared_logits(module, input_ids, attention_mask, position_ids, response_length):
+    """Logits predicting each response token, (B, R', vocab) for the first R' response positions (R' = longest real
+    response in the batch, at least 1; later positions are padding). Equals
+    module(input_ids, attention_mask, position_ids).logits[:, -R-1:-1][:, :R']."""
+    B, S = input_ids.shape
+    P = S - response_length
+    r_eff = max(int(attention_mask[:, P:].sum(1).max().item()), 1)
+    # group on tokens + mask + positions: identical tokens under a different mask must not share a cache
+    key = torch.cat([input_ids[:, :P], attention_mask[:, :P], position_ids[:, :P]], 1)
+    uniq, inv = torch.unique(key, dim=0, return_inverse=True)
+    ids_p, mask_p, pos_p = uniq.split(P, dim=1)
+    out_p = module(input_ids=ids_p, attention_mask=mask_p, position_ids=pos_p, use_cache=True, logits_to_keep=1)
+    assert out_p.past_key_values is not None, "prefix_shared_forward needs the KV cache: turn gradient checkpointing off"
+    last = out_p.logits[:, -1][inv]  # (B, V): predicts the first response token
+    if r_eff == 1:
+        return last[:, None], r_eff
+    cache = out_p.past_key_values
+    cache.batch_select_indices(inv)  # one prompt cache per row (a differentiable gather)
+    r = r_eff - 1  # response tokens whose next-token logits are needed (the last one predicts nothing)
+    out_r = module(input_ids=input_ids[:, P:P + r], attention_mask=attention_mask[:, :P + r],
+                   position_ids=position_ids[:, P:P + r], past_key_values=cache, use_cache=True,
+                   cache_position=torch.arange(P, P + r, device=input_ids.device))
+    return torch.cat([last[:, None], out_r.logits], 1), r_eff
