+"""Shared-prompt sampling decode for small models (rollout.prefix_decode, maze study).
+
+A drop-in for GraphDecoder.generate (model.generate(do_sample=True, top_k=0, top_p=1) on unpadded prompts of one length):
+the same sampling distribution and outputs (.sequences, .logits = raw per-step logits, or None with want_logits=False),
+computed with less work; it runs outside autocast (the plain copy is already in the rollout dtype).
+- Rows that share a prompt (the n samples of a train prompt, or the consecutive repeated rows of validation) form a group
+  with one copy of the prompt's KV cache; each decode step reads it once per group instead of once per row (the 654-token
+  25x25 prompt is ~70% of the context). The prompt is prefilled once per group.
+- Each row's own cache holds only its generated tokens; attention reads them up to the end of the current segment.
+- Decoding runs in segments of SEG tokens. At each segment boundary the layout drops finished rows (and groups whose rows
+  have all finished) when that removes >= 25% of the rows, so the batch shrinks as rows finish instead of running every
+  row to the longest one. Within a segment the shapes are fixed: the first step runs eagerly on a side stream (the
+  CUDA-graph warm-up), the step is captured once, and the remaining steps replay the graph, sampling included (Gumbel-max,
+  i.e. a draw from softmax(logits / T)). All-finished is checked every 8 tokens. The layout stays rectangular (groups x
+  rows), so one group with every row alive holds compaction back; a ragged layout would compact earlier.
+Prompt and response scores share one fp32 softmax, so each step equals ordinary attention over prompt + generated tokens
+up to fp16 rounding. Layers reuse the model's own modules (norms, projections, rotary, MLP).
+"""
+
+from types import SimpleNamespace
+
+import torch
+from transformers.models.qwen2.modeling_qwen2 import apply_rotary_pos_emb
+
+SEG = 32  # tokens per segment (one graph capture each)
+COMPACT_KEEP_FRAC = 0.75  # compact when the kept layout is at most this fraction of the current one (None: never)
+assert SEG % 8 == 0  # every segment boundary follows an all-finished check, so _compact always has an unfinished row
+
+
+class PrefixSharedDecoder:
+    def __init__(self, model, max_new_tokens, use_graphs=True):
+        cfg = model.config
+        assert cfg.model_type == "qwen2", cfg.model_type
+        self.model, self.max_new, self.use_graphs = model, max_new_tokens, use_graphs
+        self.h, self.kvh = cfg.num_attention_heads, cfg.num_key_value_heads
+        self.d = getattr(cfg, "head_dim", None) or cfg.hidden_size // cfg.num_attention_heads
+        self.rep = self.h // self.kvh
+        self.scale = self.d ** -0.5
+        self._side = None  # one side stream for warm-up + capture: a new stream per segment costs a cuBLAS workspace each
+
+    @staticmethod
+    def _sample(logits, T):
+        """A draw from softmax(logits / T) per row (Gumbel-max: capturable, no host sync)."""
+        gumbel = -torch.empty_like(logits).exponential_().clamp_min_(1e-30).log()
+        return torch.argmax(logits / T + gumbel, -1)
+
+    def _forward(self, tok, pos, t, W, st):
+        """Logits (G*n, vocab, float32) after tokens tok (G*n,) at position pos (device (1,)); their K/V go to response
+        slot t (device (1,)); attention covers the prompt and response slots [0, t] of the first W."""
+        m, G, n, kvh, rep, d = self.model.model, st["G"], st["n"], self.kvh, self.rep, self.d
+        B = G * n
+        x = m.embed_tokens(tok[:, None])  # (B, 1, H)
+        cos, sin = m.rotary_emb(x[:1], pos.view(1, 1))
+        future = (torch.arange(W, device=tok.device) > t).view(1, 1, 1, 1, W)
+        for li, layer in enumerate(m.layers):
+            attn = layer.self_attn
+            hs = layer.input_layernorm(x)
+            q = attn.q_proj(hs).view(B, 1, self.h, d).transpose(1, 2)  # (B, h, 1, d)
+            k = attn.k_proj(hs).view(B, 1, kvh, d).transpose(1, 2)  # (B, kvh, 1, d)
+            v = attn.v_proj(hs).view(B, 1, kvh, d).transpose(1, 2)
+            q, k = apply_rotary_pos_emb(q, k, cos, sin)
+            Kp, Vp, Kr, Vr = st["Kp"][li], st["Vp"][li], st["Kr"][li], st["Vr"][li]
+            # (G, kvh, n, ...) layout: query head j uses kv head j // rep, as HF's repeat_kv
+            Kr.index_copy_(3, t, k.view(G, n, kvh, 1, d).transpose(1, 2))
+            Vr.index_copy_(3, t, v.view(G, n, kvh, 1, d).transpose(1, 2))
+            qg = (q * self.scale).view(G, n, kvh, rep, d).transpose(1, 2)  # (G, kvh, n, rep, d); scaled first (fp16)
+            L = Kp.shape[2]
+            sp = torch.matmul(qg.reshape(G, kvh, n * rep, d), Kp.transpose(-1, -2)).view(G, kvh, n, rep, L)
+            kr, vr = Kr[:, :, :, :W], Vr[:, :, :, :W]  # (G, kvh, n, W, d)
+            sr = torch.matmul(qg, kr.transpose(-1, -2)).float().masked_fill(future, float("-inf"))  # (G,kvh,n,rep,W)
+            p = torch.softmax(torch.cat([sp.float(), sr], -1), -1).to(q.dtype)
+            op = torch.matmul(p[..., :L].reshape(G, kvh, n * rep, L), Vp).view(G, kvh, n, rep, d)
+            o = op.float() + torch.matmul(p[..., L:], vr).float()  # partial sums added in fp32
+            o = o.to(q.dtype).transpose(1, 2).reshape(B, 1, self.h * d)
+            x = x + attn.o_proj(o)
+            x = x + layer.mlp(layer.post_attention_layernorm(x))
+        return self.model.lm_head(m.norm(x))[:, 0].float()
+
+    def _token_step(self, st, W, Lp, T, pad_id, eos):
+        """Record the current logits, sample the next token of every row, mark finished rows, then compute the logits
+        after that token. Mutates st in place (static shapes within a segment)."""
+        t = st["t"]
+        idx = (st["flat"], t.expand(st["flat"].numel()))
+        if st["logits_out"] is not None:
+            st["logits_out"].index_put_(idx, st["logits"])
+        done = st["done"].view(-1)
+        nxt = torch.where(done, pad_id, self._sample(st["logits"], T))
+        st["toks_out"].index_put_(idx, nxt)
+        done |= (nxt[:, None] == eos).any(1)  # not torch.isin: its sort path (many eos ids) syncs, which breaks capture
+        st["logits"].copy_(self._forward(nxt, Lp + t, t, W, st))
+        t += 1
+
+    def _compact(self, st, t):
+        """Keep the unfinished rows (fewest columns that hold them) of the groups that still have one, if the kept layout
+        is at most COMPACT_KEEP_FRAC of the current one. t = response slots filled so far."""
+        done, G, n = st["done"], st["G"], st["n"]
+        cnt = (~done).sum(1)
+        keep = (cnt > 0).nonzero().squeeze(1)
+        n_new = int(cnt.max())
+        if COMPACT_KEEP_FRAC is None or keep.numel() * n_new > COMPACT_KEEP_FRAC * G * n:
+            return
+        sel = torch.argsort(done.int(), dim=1, stable=True)[keep, :n_new]  # unfinished rows first
+        gi = keep[:, None]
+        st["rows"], st["done"] = st["rows"][gi, sel], done[gi, sel].clone()
+        st["logits"] = st["logits"].view(G, n, -1)[gi, sel].reshape(keep.numel() * n_new, -1)
+        st["Kp"], st["Vp"] = [k[keep] for k in st["Kp"]], [v[keep] for v in st["Vp"]]
+        for key in ("Kr", "Vr"):
+            for li, c in enumerate(st[key]):  # (G, kvh, n, R, d); one layer at a time
+                full = c.new_zeros(keep.numel(), self.kvh, n_new, self.max_new, self.d)  # zeros: 0 x garbage can be NaN
+                full[:, :, :, :t] = c[:, :, :, :t].permute(0, 2, 1, 3, 4)[gi, sel].permute(0, 2, 1, 3, 4)
+                st[key][li] = full
+        st["G"], st["n"] = keep.numel(), n_new
+
+    @torch.no_grad()
+    def generate(self, input_ids, temperature, eos_ids, pad_id, num_return_sequences=1, want_logits=True):
+        with torch.autocast("cuda", enabled=False):  # copy is in the rollout dtype
+            return self._generate(input_ids, temperature, eos_ids, pad_id, num_return_sequences, want_logits)
+
+    def _generate(self, input_ids, temperature, eos_ids, pad_id, num_return_sequences, want_logits):
+        dev = input_ids.device
+        if num_return_sequences > 1:  # train: every input row is a prompt with n samples
+            prompts, n0 = input_ids, num_return_sequences
+            G0 = prompts.shape[0]
+            rows = torch.arange(G0 * n0, device=dev).view(G0, n0)
+            x_full = input_ids.repeat_interleave(n0, 0)
+        else:  # validation: rows arrive repeated (interleaved); group runs of identical consecutive rows
+            x_full = input_ids
+            new = torch.ones(input_ids.shape[0], dtype=torch.bool, device=dev)
+            new[1:] = (input_ids[1:] != input_ids[:-1]).any(1)
+            gid = torch.cumsum(new.long(), 0) - 1
+            starts = new.nonzero().squeeze(1)
+            G0, n0 = starts.numel(), int(torch.bincount(gid).max())
+            prompts = input_ids[starts]
+            slot = torch.arange(input_ids.shape[0], device=dev) - starts[gid]
+            rows = torch.full((G0, n0), -1, dtype=torch.long, device=dev)
+            rows[gid, slot] = torch.arange(input_ids.shape[0], device=dev)
+        B, Lp = x_full.shape
+        nl = len(self.model.model.layers)
+        out = self.model(input_ids=prompts, use_cache=True, logits_to_keep=1)  # prefill once per prompt
+        Kp = [layer.keys for layer in out.past_key_values.layers]
+        Vp = [layer.values for layer in out.past_key_values.layers]
+        first = out.logits[:, -1].float()  # (G0, V)
+        del out
+        V = first.shape[-1]
+        st = {
+            "G": G0, "n": n0, "rows": rows, "done": rows < 0,  # empty slots count as finished
+            "Kp": [k.contiguous() for k in Kp], "Vp": [v.contiguous() for v in Vp],
+            "Kr": [Kp[0].new_zeros(G0, self.kvh, n0, self.max_new, self.d) for _ in range(nl)],
+            "logits": first[:, None].expand(G0, n0, V).reshape(G0 * n0, V).clone(),
+            "toks_out": torch.full((B + 1, self.max_new), pad_id, dtype=torch.long, device=dev),  # row B: empty slots
+            "logits_out": torch.zeros(B + 1, self.max_new, V, device=dev) if want_logits else None,
+            "t": torch.zeros(1, dtype=torch.long, device=dev),
+        }
+        st["Vr"] = [torch.zeros_like(c) for c in st["Kr"]]  # unfilled slots get weight 0, and must not hold NaN/inf
+        eos = torch.tensor(eos_ids, device=dev)
+        T = max(float(temperature), 1e-6)
+        pool = torch.cuda.graph_pool_handle() if self.use_graphs else None
+        t, finished, graphs = 0, False, []  # graphs share one pool, so all stay alive until the call ends
+        while t < self.max_new and not finished:
+            if t > 0:
+                self._compact(st, t)
+            st["flat"] = torch.where(st["rows"] < 0, B, st["rows"]).view(-1)
+            end = min(t + SEG, self.max_new)  # response slots [0, end) cover every step of this segment
+            graph = None
+            while t < end:
+                if graph is not None:
+                    graph.replay()
+                elif self.use_graphs and end - t > 2:
+                    if self._side is None:
+                        self._side = torch.cuda.Stream()
+                    side = self._side  # warm-up (a real step) on the side stream, then capture the same step
+                    side.wait_stream(torch.cuda.current_stream())
+                    with torch.cuda.stream(side):
+                        self._token_step(st, end, Lp, T, pad_id, eos)
+                    torch.cuda.current_stream().wait_stream(side)
+                    graph = torch.cuda.CUDAGraph()
+                    graphs.append(graph)
+                    # raw capture: torch.cuda.graph() runs gc.collect() + empty_cache() on entry (~0.1 s a segment)
+                    with torch.cuda.stream(side):  # thread_local: CUDA calls from other threads can't fail the capture
+                        graph.capture_begin(pool=pool, capture_error_mode="thread_local")
+                        try:
+                            self._token_step(st, end, Lp, T, pad_id, eos)
+                        finally:
+                            graph.capture_end()
+                    torch.cuda.current_stream().wait_stream(side)
+                else:
+                    self._token_step(st, end, Lp, T, pad_id, eos)
+                t += 1
+                if t % 8 == 0 and bool(st["done"].all()):
+                    finished = True
+                    break
+        steps = t
+        seq = torch.cat([x_full, st["toks_out"][:B, :steps]], 1)
+        lg = tuple(st["logits_out"][:B, s] for s in range(steps)) if want_logits else None
+        return SimpleNamespace(sequences=seq, logits=lg)
