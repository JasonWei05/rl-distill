+            logits = torch.stack(output.logits, dim=1).float() / max(float(temperature), 1e-6)  # (bs, steps, vocab)
+            logp_all = torch.log_softmax(logits, dim=-1)
+            lp = logp_all.gather(-1, response[:, :steps].unsqueeze(-1)).squeeze(-1)
+            rollout_log_probs = torch.zeros(response.shape, dtype=torch.float32, device=response.device)
+            rollout_log_probs[:, :steps] = lp
+            tensors["rollout_log_probs"] = rollout_log_probs * response_attention_mask.to(torch.float32)
+            # entropy of the sampling distribution per response token (actor/entropy when the old-log-prob pass is skipped)
+            rollout_entropys = torch.zeros(response.shape, dtype=torch.float32, device=response.device)
+            rollout_entropys[:, :steps] = -(logp_all.exp() * logp_all).sum(-1)
+            tensors["rollout_entropys"] = rollout_entropys * response_attention_mask.to(torch.float32)
+            del logits, logp_all, lp
+        batch = TensorDict(tensors, batch_size=generated_batch_size)
+        if prof:
+            torch.cuda.synchronize(); print(f"[rollout-prof] post {time.perf_counter() - t_post:.3f}s", flush=True)
 
         # empty cache before compute old_log_prob
         get_torch_device().empty_cache()
