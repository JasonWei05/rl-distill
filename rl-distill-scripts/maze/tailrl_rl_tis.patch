+@register_adv_est(AdvantageEstimator.REINFORCE_BATCH)
+def compute_reinforce_batch_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    epsilon: float = 1e-6,
+    **kwargs,
+):
+    """
+    REINFORCE without groups (rollout.n = 1): every prompt has one sample, and the outcome reward is normalized across the
+    whole batch, A_i = (r_i - mean_batch(r)) / (std_batch(r) + epsilon), with the unbiased std as in GRPO; broadcast over the
+    response tokens. If every reward in the batch is equal, all advantages are 0.
+    """
+    scores = token_level_rewards.sum(dim=-1)
+    with torch.no_grad():
+        std = scores.std() if scores.numel() > 1 else torch.ones((), device=scores.device)
+        advantages = ((scores - scores.mean()) / (std + epsilon)).unsqueeze(-1) * response_mask
+    return advantages, advantages
+
