@@ -186,6 +186,7 @@ class AdvantageEstimator(str, Enum):
     PKPO_CONTINUOUS = "pkpo_continuous"
     REINFORCE = "reinforce"
     TAILRL = "tailrl"
+    OPD_TOKEN = "opd_token"  # on-policy distillation, policy-gradient form (PG-k1)
 
 
 class AdaptiveKLController:
@@ -1331,3 +1332,22 @@ def compute_tailrl_outcome_advantage(
 
         advantages = tailrl_advantages.flatten().unsqueeze(-1) * response_mask
     return advantages, advantages
+
+
+@register_adv_est(AdvantageEstimator.OPD_TOKEN)
+def compute_opd_token_advantage(token_level_rewards: torch.Tensor, response_mask: torch.Tensor, config=None, **kwargs):
+    """On-policy distillation in policy-gradient form (PG-k1; rl-distill RECIPES.md section 3.1).
+
+    With algorithm.use_kl_in_reward=True, kl_penalty=k1, kl_coef=1 and a zero task reward, each response token's
+    reward is -(log pi_theta(y_t) - log pi_T(y_t)) = log pi_T(y_t) - log pi_theta(y_t). The advantage is that
+    token's own value, clipped to [-c, c] (c = algorithm.opd_max_clamp, default 5): no normalisation, no
+    discounting, no sum over future tokens. Returns are set equal to the advantages.
+    """
+    clamp = 5.0
+    if config is not None:
+        try:
+            clamp = float(config.get("opd_max_clamp", 5.0))
+        except Exception:
+            pass
+    advantages = token_level_rewards.clamp(-clamp, clamp) * response_mask
+    return advantages, advantages
