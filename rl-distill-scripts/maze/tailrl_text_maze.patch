diff --git a/experiments/text_maze/src/maze_zero_reward.py b/experiments/text_maze/src/maze_zero_reward.py
new file mode 100644
index 0000000..c6201e0
--- /dev/null
+++ b/experiments/text_maze/src/maze_zero_reward.py
@@ -0,0 +1,15 @@
+"""Zero task reward for on-policy distillation (PG-k1): the training signal is the KL term alone.
+
+Returns score 0.0 for every rollout while still reporting the maze judge's outcome fields, so the
+validation metrics (goal_reached, is_shortest, wall_collision, ...) are logged exactly as for RL.
+Mirrors rl-distill's `use_task_rewards=False` (rl-distill-scripts/docs/RECIPES.md, section 3.1).
+"""
+
+from verl.utils.reward_score.maze import judge_maze
+
+
+def compute_score(data_source, solution_str, ground_truth, extra_info=None, **kwargs):
+    res = judge_maze(solution_str=solution_str, ground_truth=ground_truth)
+    res["task_score"] = res.get("score", 0.0)  # keep the goal-reached signal visible in the metrics
+    res["score"] = 0.0
+    return res
