+def test_training_local_logprobs_chunking_matches_forward_and_backward(monkeypatch):
+    torch.manual_seed(37)
+    input_ids = torch.randint(0, 19, (2, 8))
+    base_logits = torch.randn(2, 8, 19)
+    seen_shapes = []
+    original_log_softmax = torch.nn.functional.log_softmax
+
+    def log_softmax(input_tensor, *args, **kwargs):
+        seen_shapes.append(tuple(input_tensor.shape))
+        return original_log_softmax(input_tensor, *args, **kwargs)
+
+    def run(chunk_size):
+        logits = base_logits.detach().clone().requires_grad_(True)
+        logprobs = get_next_token_logprobs_from_logits(
+            input_ids=input_ids,
+            next_token_logits=logits,
+            chunk_size=chunk_size,
+        )
+        logprobs.sum().backward()
+        return logprobs.detach(), logits.grad.detach()
+
+    expected_logprobs, expected_grad = run(None)
+    monkeypatch.setattr(torch.nn.functional, "log_softmax", log_softmax)
+    actual_logprobs, actual_grad = run(3)
+
+    torch.testing.assert_close(actual_logprobs, expected_logprobs)
+    torch.testing.assert_close(actual_grad, expected_grad)
+    assert seen_shapes == [(2, 1, 19)] * 7
+
