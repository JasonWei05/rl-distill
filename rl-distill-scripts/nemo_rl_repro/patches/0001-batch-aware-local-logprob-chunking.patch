+def get_local_logprob_seq_chunk_size(
+    batch_size: int,
+    max_tokens_per_chunk: int,
+) -> int:
+    """Convert a local logprob token budget into a sequence chunk size.
+
+    Local logits have shape ``[B, S, V]``, so chunking only ``S`` does not
+    actually bound the temporary vocabulary buffer when dynamic batching makes
+    ``B > 1``.  Treat ``max_tokens_per_chunk`` as a budget over ``B * S`` and
+    reduce the sequence slice accordingly.
+    """
+    if max_tokens_per_chunk <= 0:
+        raise ValueError(
+            f"max_tokens_per_chunk must be positive, got {max_tokens_per_chunk}"
+        )
+    return max(1, max_tokens_per_chunk // max(1, batch_size))
+
+
+class ChunkedLocalLogprob(torch.autograd.Function):
+    """Compute selected local-vocabulary logprobs with bounded peak memory.
+
+    The ordinary autograd graph retains every chunk's full-vocabulary
+    log-softmax output until backward, defeating sequence chunking. This custom
+    function saves only the original logits and targets, then rematerializes one
+    chunk at a time during backward.
+    """
+
+    @staticmethod
+    def forward(  # pyrefly: ignore[bad-override]
+        ctx: Any,
+        logits: torch.Tensor,
+        target: torch.Tensor,
+        chunk_size: int,
+    ) -> torch.Tensor:
+        seq_chunk_size = get_local_logprob_seq_chunk_size(
+            int(logits.shape[0]), chunk_size
+        )
+        seq_size = int(logits.shape[1])
+        selected_logprobs = []
+        for chunk_start in range(0, seq_size, seq_chunk_size):
+            chunk_end = min(chunk_start + seq_chunk_size, seq_size)
+            chunk_logits = logits[:, chunk_start:chunk_end].to(torch.float32)
+            chunk_logprobs = torch.nn.functional.log_softmax(chunk_logits, dim=-1)
+            selected_logprobs.append(
+                chunk_logprobs.gather(
+                    dim=-1,
+                    index=target[:, chunk_start:chunk_end].unsqueeze(-1),
+                ).squeeze(-1)
+            )
+            del chunk_logprobs, chunk_logits
+
+        ctx.save_for_backward(logits, target)
+        ctx.seq_chunk_size = seq_chunk_size
+        return torch.cat(selected_logprobs, dim=1)
+
+    @staticmethod
+    def backward(
+        ctx: Any,
+        *grad_outputs: torch.Tensor,
+    ) -> tuple[torch.Tensor, None, None]:
+        grad_output = grad_outputs[0]
+        logits, target = ctx.saved_tensors
+        seq_chunk_size = ctx.seq_chunk_size
+        seq_size = int(logits.shape[1])
+
+        grad_input = torch.empty_like(logits)
+        for chunk_start in range(0, seq_size, seq_chunk_size):
+            chunk_end = min(chunk_start + seq_chunk_size, seq_size)
+            chunk_logits = logits[:, chunk_start:chunk_end].to(torch.float32)
+            chunk_grad = torch.nn.functional.softmax(chunk_logits, dim=-1)
+            chunk_grad.neg_()
+            target_chunk = target[:, chunk_start:chunk_end].unsqueeze(-1)
+            chunk_grad.scatter_add_(
+                dim=-1,
+                index=target_chunk,
+                src=torch.ones_like(target_chunk, dtype=chunk_grad.dtype),
+            )
+            chunk_grad.mul_(grad_output[:, chunk_start:chunk_end].unsqueeze(-1))
+            grad_input[:, chunk_start:chunk_end].copy_(chunk_grad)
+            del chunk_grad, chunk_logits, target_chunk
+
+        return grad_input, None, None
+
