# syntax=docker/dockerfile:1.3
# Megatron+vLLM image for the Gemma3 MoE RL scripts. Builds the full
# .venv-megatron stack (torch 2.10 cu129, vLLM 0.18, TransformerEngine 2.12,
# flash-attn, Apex, megatron-core 0.16, Megatron-Bridge fork from third_party/)
# via setup_megatron.sh. Source-builds TE/flash-attn/Apex — expect a long
# first build; subsequent builds reuse the Docker layer cache.
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONFAULTHANDLER=1
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV PIP_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=https://pypi.org/simple
ENV UV_NO_CONFIG=1
ENV HF_HOME=/tmp/hf_cache
ENV XDG_CACHE_HOME=/tmp/.cache
ENV DD_SERVICE=rl-distill

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    iproute2 \
    libnuma-dev \
    openssh-client \
    procps \
    sudo \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /workspace/rl-distill

COPY . /workspace/rl-distill

RUN SKIP_GPU_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=9.0 \
    MAX_JOBS=96 \
    RUN_HEAVY_BUILDS=1 \
    RUN_SMOKE_TEST=0 \
    VENV_DIR=/workspace/rl-distill/.venv-megatron \
    MEGATRON_BRIDGE_PATH=/workspace/rl-distill/third_party/Megatron-Bridge \
    CACHE_DIR=/tmp/megatron-build \
    bash setup_megatron.sh \
    && rm -rf /tmp/megatron-build

ENV PATH="/workspace/rl-distill/.venv-megatron/bin:${PATH}"

RUN python3 -c "import torch, vllm, transformers, megatron.core, megatron.bridge, flash_attn, apex, transformer_engine; print(torch.__version__, vllm.__version__, transformers.__version__)"
