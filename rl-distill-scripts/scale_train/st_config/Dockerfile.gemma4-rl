# syntax=docker/dockerfile:1.3
# Training-only Gemma 4 image. The RL runtime does not import lm_eval, so this
# variant avoids shipping/installing the benchmark task corpus while retaining
# the exact verl, torch, vLLM, and FlashAttention base stack.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONFAULTHANDLER=1
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV PIP_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=https://pypi.org/simple
ENV HF_HOME=/tmp/hf_cache
ENV XDG_CACHE_HOME=/tmp/.cache
ENV DD_SERVICE=rl-distill
ENV INSTALL_LM_EVAL_HARNESS=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    iproute2 \
    libnuma-dev \
    openssh-client \
    procps \
    sudo \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/rl-distill

COPY . /workspace/rl-distill

RUN test -f /workspace/rl-distill/verl/third_party/vllm/__init__.py
RUN test ! -e /workspace/rl-distill/lm-evaluation-harness

RUN PIP_INDEX_URL=https://pypi.org/simple \
    UV_INDEX_URL=https://pypi.org/simple \
    bash rl-distill-scripts/setup_env.sh

ENV PATH="/workspace/rl-distill/.venv/bin:${PATH}"
ENV PYTHONPATH="/workspace/rl-distill:${PYTHONPATH}"

RUN command -v aws \
    && aws --version \
    && python3 -c "import torch, vllm, flash_attn, transformers; print(torch.__version__, vllm.__version__, flash_attn.__version__, transformers.__version__)"
